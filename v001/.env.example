# Inventory source: "canonical" (default; real data only) or "fixture" (labelled demonstration data for QA).
LIMAR_INVENTORY=canonical
# Set to "production" only on the live deployment. Enables production guards (no fixture data, no dev outbox, no dev Site ID).
LIMAR_DEPLOY_ENV=development
# Public origin used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.limarhomes.com
# Server-only: where validated enquiries are delivered (CRM/automation webhook). Never expose client-side.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# Merqon Site Signature: production Site ID from the Merqon registry. Leave empty until allocated.
MERQON_SITE_ID=
